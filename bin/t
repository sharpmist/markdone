#!/usr/bin/env zsh
# t - personal todo list kept as one Markdown file.
# Run `t help` for usage. Configured with environment variables (see README.md):
#   TODO_FILE       the list (default: ~/todo/Todo.md)
#   TODO_JIRA_KEYS  Jira project keys to link, space-separated, e.g. "PROJ OPS"; empty = no links
#   TODO_JIRA_URL   Jira browse URL the keys are appended to, e.g. https://your-company.atlassian.net/browse/

# The release version. A pushed git tag v<version> must match it (checked in CI).
T_VERSION=0.2.0

zmodload zsh/datetime zsh/system || exit 1

f="${TODO_FILE:-$HOME/todo/Todo.md}"

# The lock, the backup and its checksum sit next to the list, hidden so notes apps ignore them; see
# lock() and save().
lockfile="${f:h}/.${f:t}.lock"
bak="${f:h}/.${f:t}.bak"
sum="${f:h}/.${f:t}.sum"   # checksum of what t last wrote, for undo

# Jira keys in items become links. Only the listed project keys count, so UTF-8 or ISO-8601 stay
# text. check_jira validates both before the list is read.
JIRA_URL="${TODO_JIRA_URL:-}"
JIRA_KEYS="${TODO_JIRA_KEYS:-}"

usage() {
  cat <<'EOF'
Usage:
  t [list]                  list open items, numbered          (aliases: ls, l)
  t list --today | --later  list only Today's or Later's open items (same numbers as t list)
  t list --done [--all]     list done items, newest first; --all includes the archives
  t list --json             open items as JSON (also with --today or --later)
  t add [--later] <text>    add an item to Today, or to Later  (alias: a; -l = --later)
  t done <item>             mark an item done                  (alias: d)
  t today <item>            move an item from Later to Today   (alias: promote)
  t later <item>            move an item from Today to Later   (alias: demote)
  t rm <item>               remove an open item                (alias: remove)
  t reword <item> <text>    replace an open item's text, keeping its place
  t pick                    choose an item with fzf, mark done (alias: f)
  t edit                    open the list in $EDITOR           (alias: e)
  t undo                    undo the last change; run it again to redo
  t init [<path>]           create the list with its three headings (never overwrites)
  t init --obsidian         create the list in an Obsidian vault you pick, in its Todo folder
  t help                    show this help                     (-h, --help)
  t version                 show the version                   (--version)
  t commands                list commands with examples, tab-separated (used by Tab completion)
  t complete <command>      list the items <command> takes, tab-separated (used by Tab completion)

<item> is a number from t list, or text that matches exactly one open item
(case-insensitive, any part of it), e.g. t done "logout fix".
For reword, quote an <item> given as text with spaces: t reword "logout" "New text".

Commands that read the list first tidy it: items ticked in an editor get
today's date and move to Done; Done items older than 7 days move to
"Archive <year>.md" next to the list; Jira keys like PROJ-123 become links
when TODO_JIRA_KEYS and TODO_JIRA_URL are set.
EOF
}

# linkify [all]: turn bare Jira keys into Markdown links. Only touches item lines
# ("- [ ] " / "- [x] ") unless "all" is given. Existing links, URLs and `code` are left alone.
# Passes input through unchanged when Jira linking is off (see check_jira).
linkify() {
  if [[ -z $JIRA_KEYS ]]; then cat; return; fi
  T_ALL="$1" T_URL="$JIRA_URL" T_KEYS="$JIRA_KEYS" perl -pe '
    BEGIN { $k = join "|", map quotemeta, split " ", $ENV{T_KEYS}; $u = $ENV{T_URL} }
    next unless $ENV{T_ALL} || /^- \[[ x]\] /;
    s{(\[[^\]]*\]\([^)]*\)|`[^`]*`|https?://\S+)|(?<![\w/-])((?:$k)-\d+)(?![\w-])}{defined $1 ? $1 : "[$2]($u$2)"}ge'
}

# render: on a terminal, show [text](url) as clickable "text" (OSC 8); otherwise pass through unchanged.
render() {
  if [[ -t 1 ]]; then
    perl -pe 's{\[([^\]]+)\]\((https?://[^)\s]+)\)}{\e]8;;$2\e\\$1\e]8;;\e\\}g'
  else
    cat
  fi
}

# AWK_SHOWN: awk function shown(s): s with each [text](http...) link reduced to its text, as
# render() shows it in a terminal. Put it in front of an awk program that uses it.
AWK_SHOWN='
  function shown(s,   o, l) {
    o = ""
    while (match(s, /\[[^]]+\]\(https?:\/\/[^) \t]+\)/)) {
      l = substr(s, RSTART, RLENGTH)
      o = o substr(s, 1, RSTART - 1) substr(l, 2, index(l, "](") - 2)
      s = substr(s, RSTART + RLENGTH)
    }
    return o s
  }'

warn() { print -r -- "t: $*" >&2; }
die() { warn "$@"; exit 1; }

# days_ago <n>: the date n days ago as YYYY-MM-DD. Counts back from today's noon, so a daylight
# saving change in between can't shift the date. Pure zsh, so BSD and GNU date don't matter.
days_ago() {
  local noon
  strftime -r -s noon '%F %T' "$(strftime %F $EPOCHSECONDS) 12:00:00" && strftime %F $(( noon - $1 * 86400 ))
}

# check_jira: Jira linking is on when TODO_JIRA_KEYS is non-empty. Turns it off, with a warning,
# when the keys or the URL are wrong, so broken links are never written into the list.
check_jira() {
  local k bad=()
  JIRA_KEYS=${(j: :)${=JIRA_KEYS}}   # trim; blank means off
  [[ -n $JIRA_KEYS ]] || return 0
  for k in ${=JIRA_KEYS}; do [[ $k =~ '^[A-Z][A-Z0-9_]*$' ]] || bad+=("$k"); done
  if (( $#bad )); then
    warn "TODO_JIRA_KEYS: '${(j:', ':)bad}' isn't a Jira project key (use uppercase keys separated by spaces); Jira linking is off"
    JIRA_KEYS=
  elif [[ -z $JIRA_URL ]]; then
    warn "TODO_JIRA_KEYS is set but TODO_JIRA_URL isn't; Jira linking is off"
    JIRA_KEYS=
  elif [[ $JIRA_URL != http(s|)://?*/ ]]; then
    warn "TODO_JIRA_URL must start with http:// or https:// and end with / (got '$JIRA_URL'); Jira linking is off"
    JIRA_KEYS=
  fi
  return 0
}

# save <tmp> [more temp files]: rewrite the list with <tmp> in place (keeps the file itself, so
# symlinks and permissions survive; not atomic). First copies the current list to $bak, so a crash
# during the write can't lose it; if that copy fails, the list isn't written. Then records the
# checksum of what it wrote in $sum, for undo. On failure removes the temp files and exits.
save() {
  if ! (umask 077; cat -- "$f" >"$bak"); then
    rm -f "$@"; die "could not write the backup $bak; list not changed"
  fi
  if ! cat "$1" >"$f"; then
    rm -f "$@"; die "could not write $f (the previous version is in $bak)"
  fi
  # undo restores $bak only while the list still has this checksum, i.e. nothing else changed it.
  # Content, not mtimes: on filesystems with 1-second times, an edit right after t's write would
  # keep the mtime. A crash before this leaves the old checksum, which no longer matches.
  if ! (umask 077; cksum <"$f" >"$sum") 2>/dev/null; then
    rm -f -- "$sum"; warn "could not write $sum; t undo won't undo this change"
  fi
  return 0
}

# commands: one line per command, "<text to insert after t>\t<description and example>".
# shell/t.zsh shows these in fzf on Tab; an insert ending in "" puts the cursor between the quotes.
commands() {
  local ins shown desc ex
  for ins shown desc ex in \
    'list'              'list'                 'List open items, numbered'                'list' \
    'list --today'      'list --today'         "List only Today's open items"             'list --today' \
    'list --later'      'list --later'         "List only Later's open items"             'list --later' \
    'list --json'       'list --json'          'List open items as JSON (for scripts)'    'list --json' \
    'list --done'       'list --done'          'List items done in the last 7 days'       'list --done' \
    'list --done --all' 'list --done --all'    'List all done items, incl. archives'      'list --done --all' \
    'add ""'            'add "<text>"'         'Add an item to Today'                     'add "Retest logout fix PROJ-123"' \
    'add --later ""'    'add --later "<text>"' 'Add an item to Later'                     'add --later "Clean up old branches"' \
    'done '             'done <item>'          'Mark an item done (number or text)'       'done "logout fix"' \
    'today '            'today <item>'         'Move an item from Later to Today'         'today 3' \
    'later '            'later <item>'         'Move an item from Today to Later'         'later 1' \
    'rm '               'rm <item>'            'Remove an item (t undo brings it back)'   'rm "old idea"' \
    'reword '           'reword <item> "<text>"' "Change an item's text"                 'reword 2 "Retest logout fix"' \
    'pick'              'pick'                 'Pick an open item with fzf, mark it done' 'pick' \
    'edit'              'edit'                 'Open the list in your editor'             'edit' \
    'undo'              'undo'                 'Undo the last change (again to redo)'     'undo' \
    'init'              'init'                 'Create the list (never overwrites)'       'init' \
    'init --obsidian'   'init --obsidian'      'Create the list in an Obsidian vault'     'init --obsidian' \
    'version'           'version'              'Show the version'                         'version' \
    'help'              'help'                 'Show help'                                'help'
  do
    printf '%s\t%-22s %-42s e.g. t %s\n' "$ins" "$shown" "$desc" "$ex"
  done
}

tidy() {
  local tmp arch lnk y af rc cutoff ok=1
  cutoff=$(days_ago 7)
  if [[ $cutoff != <->-<->-<-> ]]; then
    warn "can't work out the date 7 days ago; old Done items not archived"
    cutoff=   # nothing compares lower, so nothing is archived
  fi
  tmp=$(mktemp); arch=$(mktemp); lnk=$(mktemp)
  if ! linkify <"$f" >"$lnk"; then
    rm -f "$tmp" "$arch" "$lnk"; die "Jira linking failed (is perl installed?); list not changed"
  fi
  awk -v today="$(date +%F)" -v cutoff="$cutoff" -v arch="$arch" '
    function stamp(l) {
      if (substr(l,7,10) !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) l = "- [x] " today " " substr(l,7)
      return l
    }
    function keep(l) { if (substr(l,7,10) < cutoff) print l > arch; else print l }
    $0=="## Done" { print; done=1; for (i=1; i<=nm; i++) keep(moved[i]); nm=0; next }
    /^## /        { done=0 }
    /^- \[x\] / && !done { moved[++nm]=stamp($0); next }
    /^- \[x\] / && done  { keep(stamp($0)); next }
    { print }
    END { exit (nm > 0) }' "$lnk" >"$tmp"; rc=$?
  if (( rc )); then
    warn "ticked items found but no '## Done' heading after them; list not tidied"
  elif ! cmp -s "$tmp" "$f"; then
    # Append to the archives first and rewrite the list only if all of that worked: a crash or
    # failed write in between can duplicate an archived item, but never lose one.
    for y in $(cut -c7-10 "$arch" | sort -u); do
      af="${f:h}/Archive $y.md"
      if ! { [[ -f $af ]] || printf '# Archive %s\n\n' "$y" >"$af"; } ||
         ! grep "^- \[x\] $y-" "$arch" | sort >>"$af"; then
        ok=0; break
      fi
    done
    if (( ok )); then
      save "$tmp" "$arch" "$lnk"
      # Undoing would put the archived items back in the list, and the next tidy would archive
      # them a second time. So a tidy that archived anything can't be undone.
      [[ -s $arch ]] && rm -f -- "$bak"
    else warn "could not write $af; list not tidied"
    fi
  fi
  rm -f "$tmp" "$arch" "$lnk"
}

# list [section]: open items, numbered across the whole list; with a section, only that section's
# items are shown, keeping the same numbers so they work with done/today/later.
list() {
  awk -v only="$1" '/^## /{sec=substr($0,4)} /^- \[ \] /{n++; if (only == "" || sec == only) printf "%3d  %-6s %s\n", n, sec, substr($0,7)}' "$f" | render
}

# list_json [section]: open items as a JSON array, one object per line, in t list order:
# {"n":1,"section":"Today","text":"...","jira":["PROJ-1"]}. text is the item as stored (Markdown).
# jira lists the configured Jira keys in it, in order, once each; empty when linking is off. Never
# rendered for a terminal, so the output is always plain JSON.
list_json() {
  awk -v only="$1" '/^## /{sec=substr($0,4)} /^- \[ \] /{n++; if (only == "" || sec == only) print n "\t" sec "\t" substr($0,7)}' "$f" |
    T_KEYS="$JIRA_KEYS" perl -ne '
      BEGIN { $k = join "|", map quotemeta, split " ", $ENV{T_KEYS} }
      sub js { my $v = shift; $v =~ s/(["\\])/\\$1/g; $v =~ s/([\x00-\x1f])/sprintf "\\u%04x", ord $1/ge; "\"$v\"" }
      chomp; my ($n, $s, $t) = split /\t/, $_, 3; my %seen;
      my @j = $k eq "" ? () : grep { !$seen{$_}++ } $t =~ /(?<![\w\/-])((?:$k)-\d+)(?![\w-])/g;
      push @o, sprintf q{{"n":%d,"section":%s,"text":%s,"jira":[%s]}}, $n, js($s), js($t), join ",", map { js($_) } @j;
      END { print @o ? "[\n" . join(",\n", @o) . "\n]\n" : "[]\n" }'
}

# list_done <all>: done items as "DATE  text", newest first. Runs after tidy, so every item has a date.
list_done() {
  local a
  {
    awk '/^## /{indone=($0=="## Done")} indone && /^- \[x\] /' "$f"
    if (( $1 )); then
      for a in "${f:h}"/Archive\ <->.md(N); do grep '^- \[x\] ' "$a"; done
    fi
  } | sort -s -r -k3,3 | awk '{print substr($0,7,10) "  " substr($0,18)}' | render
}

# insert_item <section> <text> <numfile>: copy stdin to stdout with "- [ ] <text>" appended to the
# end of <section>, before its trailing blank lines, and write the item's new number to <numfile>.
# Fails when the section heading is missing.
insert_item() {
  T_TEXT="$2" awk -v sec="## $1" -v out="$3" '
    function ins() { print "- [ ] " ENVIRON["T_TEXT"]; print n+1 > out; added=1 }
    function flush() { printf "%s", blanks; blanks="" }
    insec && !added && /^## / { ins(); flush(); insec=0 }
    insec && !added && /^[ \t]*$/ { blanks = blanks $0 "\n"; next }
    insec && !added { flush() }
    /^- \[ \] / { n++ }
    $0==sec && !added { insec=1 }
    { print }
    END { if (insec && !added) { ins(); flush() } exit !added }'
}

# add <section> <text>
add() {
  local sec=$1 text=$2 tmp out
  [[ -n $text ]] || die "usage: t add [--later] <text>"
  [[ $text != *$'\n'* ]] || die "item must be a single line"
  text=$(print -r -- "$text" | linkify all) || die "Jira linking failed (is perl installed?); nothing added"
  tmp=$(mktemp); out=$(mktemp)
  if insert_item "$sec" "$text" "$out" <"$f" >"$tmp"; then
    save "$tmp" "$out"
    print -r -- "Added $(<"$out") ($sec): $text" | render
    rm -f "$tmp" "$out"
  else
    rm -f "$tmp" "$out"; die "no '## $sec' heading in $f"
  fi
}

# item <command> <ref...>: print the number of the open item that ref names, for t <command>. ref is
# a number from t list, or text matching exactly one open item: a case-insensitive substring of the
# item as a terminal shows it, with each [text](http...) link reduced to its text, so a linked Jira
# key matches but its URL doesn't. Text is matched literally, not as a pattern.
# Dies when nothing or more than one item matches, listing the matches. Called as
# n=$(item ...) || exit, so die only ends the subshell; the lock is held all along, so the number
# can't change before it's used.
item() {
  local cmd=$1 ref matches; shift; ref="$*"
  [[ -n $ref ]] || die "usage: t $cmd <item>"
  if [[ $ref == <-> ]]; then print -r -- "$ref"; return 0; fi
  matches=$(T_REF="$ref" awk "$AWK_SHOWN"'
    BEGIN { r = tolower(ENVIRON["T_REF"]) }
    /^## / { sec = substr($0, 4) }
    /^- \[ \] / { n++; if (index(tolower(shown(substr($0, 7))), r)) printf "%3d  %-6s %s\n", n, sec, substr($0, 7) }
  ' "$f") || die "could not read $f"
  [[ -n $matches ]] || die "no open item matches '$ref'"
  [[ $matches != *$'\n'* ]] ||
    die "'$ref' matches ${#${(f)matches}} open items; use more of the text, or the number:"$'\n'"$matches"
  print -r -- ${${=matches}[1]}
}

finish() {
  local n=$1 tmp out
  [[ $n == <-> ]] || die "usage: t done <item>"
  tmp=$(mktemp); out=$(mktemp)
  if awk -v N="$n" -v D="$(date +%F)" -v out="$out" '
      NR==FNR { if (/^- \[ \] / && ++c==N) item=substr($0,7); next }
      /^- \[ \] / && ++m==N { next }
      { print }
      $0=="## Done" && item!="" && !ok { print "- [x] " D " " item; print item > out; ok=1 }
      END { exit !ok }' "$f" "$f" >"$tmp"; then
    save "$tmp" "$out"
    print -r -- "Done: $(<"$out")" | render
    rm -f "$tmp" "$out"
  else
    rm -f "$tmp" "$out"; die "no open item $n (or no '## Done' heading)"
  fi
}

# remove <n>: delete open item n.
remove() {
  local n=$1 tmp out
  [[ $n == <-> ]] || die "usage: t rm <item>"
  tmp=$(mktemp); out=$(mktemp)
  if awk -v N="$n" -v out="$out" '
      /^- \[ \] / && ++c==N { print substr($0,7) > out; found=1; next }
      { print }
      END { exit !found }' "$f" >"$tmp"; then
    save "$tmp" "$out"
    print -r -- "Removed: $(<"$out")" | render
    rm -f "$tmp" "$out"
  else
    rm -f "$tmp" "$out"; die "no open item $n"
  fi
}

# reword <n> <text>: replace open item n's text, keeping its section and position.
reword() {
  local n=$1 text=$2 tmp out
  [[ $n == <-> && -n $text ]] || die "usage: t reword <item> <new text>"
  [[ $text != *$'\n'* ]] || die "item must be a single line"
  text=$(print -r -- "$text" | linkify all) || die "Jira linking failed (is perl installed?); nothing changed"
  tmp=$(mktemp); out=$(mktemp)
  if T_TEXT="$text" awk -v N="$n" -v out="$out" '
      /^## / { sec = substr($0, 4) }
      /^- \[ \] / && ++c==N { print "- [ ] " ENVIRON["T_TEXT"]; print c " (" sec ")" > out; found=1; next }
      { print }
      END { exit !found }' "$f" >"$tmp"; then
    save "$tmp" "$out"
    print -r -- "Reworded $(<"$out"): $text" | render
    rm -f "$tmp" "$out"
  else
    rm -f "$tmp" "$out"; die "no open item $n"
  fi
}

# move <section> <command> <n>: move open item n to the end of <section> (Today or Later), in one write.
move() {
  local to=$1 cmd=$2 n=$3 found sec item tmp out
  [[ $n == <-> ]] || die "usage: t $cmd <item>"
  found=$(awk -v N="$n" '/^## /{sec=substr($0,4)} /^- \[ \] / && ++c==N {print sec "\t" substr($0,7); exit}' "$f")
  [[ -n $found ]] || die "no open item $n"
  sec=${found%%$'\t'*}; item=${found#*$'\t'}
  [[ $sec != $to ]] || die "item $n is already in $to"
  tmp=$(mktemp); out=$(mktemp)
  if awk -v N="$n" '/^- \[ \] / && ++c==N {next} {print}' "$f" | insert_item "$to" "$item" "$out" >"$tmp"; then
    save "$tmp" "$out"
    print -r -- "Moved to $to as $(<"$out"): $item" | render
    rm -f "$tmp" "$out"
  else
    rm -f "$tmp" "$out"; die "no '## $to' heading in $f"
  fi
}

# obsidian_vaults: the vault directories Obsidian knows about, one per line, most recently opened
# first. Read from Obsidian's own list of vaults (obsidian.json, in the macOS, Linux, Flatpak or
# Snap location); vaults whose directory is gone are left out. Prints nothing when there are none.
obsidian_vaults() {
  local c
  for c in "$HOME/Library/Application Support/obsidian/obsidian.json" \
           "${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json" \
           "$HOME/.var/app/md.obsidian.Obsidian/config/obsidian/obsidian.json" \
           "$HOME/snap/obsidian/current/.config/obsidian/obsidian.json"; do
    [[ -r $c ]] || continue
    perl -MJSON::PP -e '
      local $/; my $j = eval { decode_json(<STDIN>) }; exit 0 unless ref $j eq "HASH";
      my $v = ref $j->{vaults} eq "HASH" ? $j->{vaults} : {};
      my @v = grep { ref $_ eq "HASH" && defined $_->{path} && $_->{path} !~ /\n/ && -d $_->{path} } values %$v;
      print "$_->{path}\n" for sort { ($b->{ts} || 0) <=> ($a->{ts} || 0) } @v' <"$c"
  done | awk '!seen[$0]++'
}

# ask <question>: print the question and read one line of answer from stdin into $REPLY. Only
# called when stdin is a terminal, so an AI agent or script is never left waiting for an answer.
# Dies when input ends (Ctrl-D), changing nothing.
ask() {
  print -rn -- "$1 "
  IFS= read -r REPLY || { print; die "no answer; nothing done" }
}

# pick_vault <offer>: choose an Obsidian vault for the list and print its directory, or nothing to
# keep the list where it is. With offer=1 (plain t init in a terminal), not using a vault is one of
# the choices; otherwise a vault must be chosen. Asks only when stdin is a terminal; otherwise a
# single vault is taken and several are an error. Prompts go to stderr; stdout is the answer.
pick_vault() {
  local offer=$1 i n; local -a v
  v=("${(@f)$(obsidian_vaults)}"); v=(${v:#})
  if (( ! $#v )); then
    (( offer )) && return 0
    die "found no Obsidian vaults (Obsidian lists a vault once you've opened it); use t init <path> instead"
  fi
  if [[ ! -t 0 ]] && (( $#v > 1 )); then
    die "found $#v Obsidian vaults; run t init --obsidian in a terminal to choose one, or t init <path>:"$'\n'"${(F)${(@)v/#/  }}"
  fi
  if (( $#v == 1 )); then
    if (( offer )); then
      ask "Keep the list in your Obsidian vault, in ${v[1]}/Todo? [Y/n]" >&2
      [[ $REPLY == ([yY]*|) ]] || return 0
    else
      print -r -- "Obsidian vault: ${v[1]}" >&2
    fi
    print -r -- "${v[1]}"; return 0
  fi
  {
    print -r -- "Obsidian vaults:"
    (( offer )) && printf '  %d  %s\n' 0 "not in a vault ($f)"
    for i in {1..$#v}; do printf '  %d  %s\n' $i "${v[i]}"; done
    ask "Which one should hold the list? [1]"
  } >&2
  n=${REPLY:-1}
  [[ $n == <-> ]] && (( n <= $#v && (n > 0 || offer) )) || die "no choice '$REPLY'; nothing done"
  (( n )) && print -r -- "${v[n]}"
  return 0
}

# zshenv_line <file>: the ~/.zshenv line that makes <file> the list, written so that a TODO_FILE set
# when t runs still wins. Paths under $HOME are written as $HOME/...; \ " $ ` are escaped.
zshenv_line() {
  local p=$1 pre=
  [[ $p == $HOME/* ]] && { pre='$HOME'; p=${p#$HOME} }
  p=${p//\\/\\\\}; p=${p//\"/\\\"}; p=${p//\$/\\\$}; p=${p//\`/\\\`}
  print -r -- "export TODO_FILE=\"\${TODO_FILE:-$pre$p}\""
}

# remember_list: make $f the list for every later t run, from the terminal or an AI agent, with a
# marked TODO_FILE line in ~/.zshenv. Asks first, and only in a terminal; otherwise it shows the
# line. Replaces the line an earlier t init wrote, and leaves ~/.zshenv alone when it sets
# TODO_FILE some other way. Rewrites in place, so a ~/.zshenv that is a symlink stays one.
remember_list() {
  local env=${ZDOTDIR:-$HOME}/.zshenv mark='# markdone: where t keeps the list (set by t init)' line other tmp
  line=$(zshenv_line "$f")
  if [[ -f $env ]]; then
    if awk -v mark="$mark" -v line="$line" 'p == mark && $0 == line { found = 1 } { p = $0 } END { exit !found }' "$env"; then
      print -r -- "${env/#$HOME/~} already points t at this list"; return 0
    fi
    other=$(awk -v mark="$mark" 'p != mark && /TODO_FILE/ { print "  " NR ": " $0 } { p = $0 }' "$env")
    if [[ -n $other ]]; then
      print -r -- "${env/#$HOME/~} already sets TODO_FILE, so it's left alone:"$'\n'"$other"
      print -r -- "To use this list, change that to:"$'\n'"  $line"
      return 0
    fi
  fi
  if [[ ! -t 0 ]]; then
    print -r -- "To use it, add this to ${env/#$HOME/~}:"$'\n'"  $line"
    return 0
  fi
  ask "Use this list from now on, also from AI agents? This adds TODO_FILE to ${env/#$HOME/~}. [Y/n]"
  if [[ $REPLY != ([yY]*|) ]]; then
    print -r -- "Not saved. To use the list, add this to ${env/#$HOME/~}:"$'\n'"  $line"
    return 0
  fi
  tmp=$(mktemp) || die "could not create a temp file; ${env/#$HOME/~} not changed"
  # Drop an earlier t init line (marker, line and the blank lines before them), then append.
  { [[ ! -f $env ]] || awk -v mark="$mark" '
      $0 == "" { blanks = blanks "\n"; next }
      $0 == mark { blanks = ""; skip = 1; next }
      skip && /TODO_FILE/ { skip = 0; next }
      { printf "%s", blanks; blanks = ""; skip = 0; print }' "$env" >"$tmp"
  } && { [[ ! -s $tmp ]] || print; print -r -- "$mark"; print -r -- "$line" } >>"$tmp" &&
    cat "$tmp" >"$env" || { rm -f "$tmp"; die "could not update $env" }
  rm -f "$tmp"
  print -r -- "Saved in ${env/#$HOME/~}: t now uses $f"
}

# init [<path> | --obsidian]: create the list with its three headings. Never overwrites: dies when
# anything is already at the file, so an existing list can't be emptied by accident.
#   t init            at $f (TODO_FILE or the default). In a terminal, with TODO_FILE unset and
#                     Obsidian vaults around, first offers to put the list in a vault instead.
#   t init <path>     at <path>, then shows the ~/.zshenv line that makes t use it. Never asks.
#   t init --obsidian in <vault>/Todo/Todo.md, for a vault chosen from Obsidian's list, then offers
#                     to remember it in ~/.zshenv. An existing list there (e.g. synced from another
#                     computer) is used as it is. Without a terminal it asks nothing: it takes the
#                     only vault (several are an error) and shows the ~/.zshenv line.
init() {
  local vault= in_vault=0 usage="usage: t init [<path> | --obsidian]"
  case $1 in
    --obsidian) (( $# == 1 )) || die "$usage"; in_vault=1; vault=$(pick_vault 0) || exit ;;
    -*) die "$usage" ;;
    "") (( $# <= 1 )) || die "$usage"
        if [[ -z ${TODO_FILE-} && -t 0 && -t 1 ]]; then vault=$(pick_vault 1) || exit; fi
        [[ -n $vault ]] && in_vault=1 ;;
    *) (( $# == 1 )) || die "$usage"; f=${1:a} ;;
  esac
  [[ -n $vault ]] && f=$vault/Todo/Todo.md
  if [[ -e $f || -L $f ]]; then
    (( in_vault )) && [[ -f $f ]] || die "$f already exists; not changed"
    print -r -- "$f already exists; using it as it is"
  else
    mkdir -p -- "${f:h}" || die "could not create the directory ${f:h}"
    printf '## Today\n\n## Later\n\n## Done\n' >"$f" || die "could not write $f"
    print -r -- "Created $f"
  fi
  if (( in_vault )); then
    remember_list
  elif [[ -n $1 && $f != ${${TODO_FILE:-$HOME/todo/Todo.md}:a} ]]; then
    local env=${ZDOTDIR:-$HOME}/.zshenv
    print -r -- "To use it, add this to ${env/#$HOME/~}:"$'\n'"  $(zshenv_line "$f")"
  fi
  return 0
}

# lock: take the list's lock, so t runs that change the list take turns instead of one silently
# dropping another's change. A kernel lock (fcntl, via zsystem flock) on $lockfile, an empty file
# that stays next to the list. The kernel releases it when this process ends, however it ends, so a
# killed t never leaves a stale lock. exec closes the lock's descriptor (no -e), so the editor that
# t edit starts doesn't hold it. Child processes don't hold it and can't release it. Waits up to 10
# seconds for another run, checking every 0.05 s (the default, once a second, lets only one waiting
# run in per second).
lock() {
  local rc
  [[ -f $lockfile ]] || { : >>"$lockfile" } 2>/dev/null || die "could not create the lock file $lockfile"
  zsystem flock -t 10 -i 0.05 -f lockfd "$lockfile" 2>/dev/null; rc=$?
  (( rc == 2 )) && die "another t has been using the list for 10 seconds; try again when it's done"
  (( rc == 0 )) || die "could not lock $lockfile"
}

# ITEM_CMDS: the commands that take an <item>, with their aliases.
ITEM_CMDS=(done d today promote later demote rm remove reword)

# complete_items <command>: the open items <command> can take, for Tab completion (shell/t.zsh). One
# line per item, "<text to insert after 't <command> '>\t<the t list line>", with links shown as
# their text. today offers Later's items and later Today's; for reword the insert ends in "" so the
# cursor lands between the quotes for the new text. For a command that takes no item, t exits
# before reading the list and prints nothing (first case block).
complete_items() {
  local only= suffix=
  case $1 in
    today|promote) only=Later ;;
    later|demote)  only=Today ;;
    reword)        suffix=' ""' ;;
  esac
  T_SUFFIX="$suffix" awk -v only="$only" "$AWK_SHOWN"'
    /^## / { sec = substr($0, 4) }
    /^- \[ \] / { n++; if (only == "" || sec == only) printf "%d%s\t%3d  %-6s %s\n", n, ENVIRON["T_SUFFIX"], n, sec, shown(substr($0, 7)) }
  ' "$f" || die "could not read $f"
}

# pick: choose an open item with fzf and mark it done. fzf can stay open for as long as you like,
# so the lock is released while it is, and other runs (an agent's t add) aren't kept waiting. Then
# it locks and tidies again and finds the chosen item by its stored text, since numbers may have
# shifted meanwhile. If several open items have that text, the one at the chosen number wins; if
# it's no longer clear which one was meant, or the item is gone, nothing is changed.
pick() {
  local shown snap choice rc n text found
  (( $+commands[fzf] )) || die "t pick needs fzf (https://github.com/junegunn/fzf)"
  shown=$(list) || die "could not read $f"
  [[ -n $shown ]] || die "no open items to pick"
  snap=$(<"$f") || die "could not read $f"
  zsystem flock -u $lockfd || die "could not unlock $lockfile"
  choice=$(print -r -- "$shown" | fzf --prompt='done> '); rc=$?
  (( rc == 0 )) || exit $rc
  n=${${=choice}[1]}
  [[ $n == <-> ]] || die "could not read the item number from fzf's output: $choice"
  text=$(print -r -- "$snap" | awk -v N="$n" '/^- \[ \] / && ++c == N { print substr($0, 7) }')
  [[ -n $text ]] || die "could not find item $n in the list as fzf showed it"
  lock
  tidy
  # Prints the number to finish, or "0 <count>" when there's none or more than one candidate.
  found=$(T_TEXT="$text" awk -v N="$n" '
    /^- \[ \] / { c++; if (substr($0, 7) == ENVIRON["T_TEXT"]) { m++; at = c; if (c == N) same = 1 } }
    END { if (same) print N; else if (m == 1) print at; else print 0, m + 0 }' "$f") ||
    die "could not read $f"
  case $found in
    "0 0") die "'$text' is no longer an open item; it was changed while fzf was open, so nothing is done" ;;
    0\ *)  die "'$text' now matches ${found#0 } open items; run t pick again" ;;
  esac
  finish "$found"
}

# undo: put back the list as it was before t's last write. The current list becomes the backup,
# so a second undo redoes. Refuses when the list was changed since that write (by hand, in an
# editor or a sync), since restoring the backup would throw that change away.
undo() {
  local tmp now
  [[ -f $bak ]] || die "nothing to undo"
  [[ -f $sum ]] ||
    die "can't tell whether the list was changed since t last wrote it; not undoing (t's previous version is in $bak)"
  now=$(cksum <"$f") || die "could not read $f; nothing undone"
  [[ $now == "$(<"$sum")" ]] ||
    die "the list was changed since t last wrote it; not undoing (t's previous version is in $bak)"
  tmp=$(mktemp) || die "could not create a temp file; nothing undone"
  if ! cat -- "$bak" >"$tmp"; then rm -f "$tmp"; die "could not read $bak; nothing undone"; fi
  save "$tmp"
  rm -f "$tmp"
  print -r -- "Undid the last change; run t undo again to redo it"
}

# Commands that don't need the list.
case "$1" in
  -h|--help|help) usage; exit 0 ;;
  --version|version) print -r -- "t $T_VERSION"; exit 0 ;;
  commands) commands; exit 0 ;;
  complete) (( ${ITEM_CMDS[(Ie)$2]} )) || exit 0 ;;   # no item to offer: don't touch the list
  init) shift; init "$@"; exit 0 ;;
esac

[[ -f $f ]] || die "$f not found; create it with 't init', or set TODO_FILE to your list"
lock
# undo runs before tidy: tidying first would be a change of its own, and undo would revert that.
[[ $1 == undo ]] && { undo; exit }
check_jira
tidy

case "$1" in
  ""|list|ls|l)
    (( $# )) && shift
    show_done=0; show_all=0; show_today=0; show_later=0; show_json=0
    for opt in "$@"; do
      case $opt in
        --done) show_done=1 ;;
        --all) show_all=1 ;;
        --today) show_today=1 ;;
        --later) show_later=1 ;;
        --json) show_json=1 ;;
        *) die "unknown option '$opt' for list (expected --today, --later, --done, --all, --json)" ;;
      esac
    done
    (( show_all && !show_done )) && die "--all only works together with --done"
    (( show_done && (show_today || show_later) )) && die "--today and --later list open items; they don't combine with --done"
    (( show_done && show_json )) && die "--json lists open items; it doesn't combine with --done"
    sec=
    (( show_today && !show_later )) && sec=Today
    (( show_later && !show_today )) && sec=Later
    if (( show_done )); then list_done $show_all
    elif (( show_json )); then list_json "$sec"
    else list "$sec"
    fi ;;
  add|a)
    shift
    if [[ $1 == (--later|-l) ]]; then shift; add Later "$*"; else add Today "$*"; fi ;;
  done|d)       n=$(item done "${@:2}") || exit; finish "$n" ;;
  today|promote) n=$(item today "${@:2}") || exit; move Today today "$n" ;;
  later|demote)  n=$(item later "${@:2}") || exit; move Later later "$n" ;;
  rm|remove)      n=$(item rm "${@:2}") || exit; remove "$n" ;;
  reword)
    [[ -n $2 && -n ${*:3} ]] || die "usage: t reword <item> <new text>"
    n=$(item reword "$2") || exit; reword "$n" "${*:3}" ;;
  pick|f) pick ;;
  complete) complete_items "$2" ;;
  edit|e) exec ${=EDITOR:-nvim} "$f" ;;   # split, so EDITOR="code -w" works
  *) print -r -- "t: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac
